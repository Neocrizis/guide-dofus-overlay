{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guide Dofus Overlay",
  "version": "1.2.0",
  "identifier": "io.github.neocrizis.guidedofus",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Neocrizis",
    "shortDescription": "Guide Dofus en overlay par-dessus le jeu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "copyright": "© 2026 Neocrizis — MIT",
    "license": "MIT",
    "homepage": "https://github.com/Neocrizis/guide-dofus-overlay",
    "longDescription": "Affiche le journal du Guide Dofus par-dessus le jeu : fenêtre sans cadre, transparente, toujours au premier plan."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "guidedofus"
        ]
      }
    }
  }
}